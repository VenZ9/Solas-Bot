# Solas Discord Bot Configuration
# Copy this file to .env and provide your values.

# Discord Bot Credentials
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_client_id_here
DISCORD_OWNER_ID=your_discord_user_id_here
DISCORD_DEV_GUILD_ID=your_development_server_guild_id_here

# Persistent Storage & Database
DATA_DIRECTORY=./data
DATABASE_PATH=./data/solas.sqlite

# Logging Configuration (debug, info, warn, error)
LOG_LEVEL=info
